# --- server ---
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# --- database ---
MONGO_URI=mongodb://127.0.0.1:27017/blue_carbon_registry

# --- auth ---
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRES_IN=7d

# --- blockchain (values printed by `npm run deploy:local` at the repo root) ---
RPC_URL=http://127.0.0.1:8545
# This is Hardhat's well-known, public, funds-free local test account #0 private key
# (same one Hardhat prints in every `npx hardhat node` run). Safe for local dev only --
# NEVER reuse it, or any hardcoded key, on a real network or wallet holding real funds.
BACKEND_ORACLE_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
CREDIT_TOKEN_ADDRESS=
REGISTRY_CONTRACT_ADDRESS=

# --- IPFS (optional; see services/ipfs.js for the local mock fallback) ---
# Get a free API key/secret from https://web3.storage or run a local IPFS node.
WEB3_STORAGE_TOKEN=

# Real IPFS (choose one)
PINATA_JWT=
IPFS_API_URL=http://127.0.0.1:5001
IPFS_GATEWAY_URL=http://127.0.0.1:8080/ipfs

# Final demo: fail closed if blockchain is not connected
REQUIRE_BLOCKCHAIN=true
